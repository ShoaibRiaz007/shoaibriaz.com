@model ArticlesViewModel
@{
    Layout = "_SiteLayout";
    var pillar = Model.PillarArticle;
    var clusters = Model.ClusterArticles;
}

<div data-progress>
    <header class="cs-hero" data-pointer="spotlight">
        <div class="container cs-hero-text">
            <nav aria-label="Breadcrumb" data-enter="hero" style="--i:0">
                <ol class="breadcrumb">
                    <li><a href="/">Home</a></li>
                    <li><span aria-current="page">Articles</span></li>
                </ol>
            </nav>
            <h1 data-enter="hero" style="--i:1">Engineering Architecture &amp; Deep Dives</h1>
            <p class="lede" data-enter="hero" style="--i:2">
                Production-tested architectural blueprints, systems engineering tutorials, and GenAI pipeline implementations across .NET 9, Windows IPC, Unity, and hybrid desktop systems.
            </p>
        </div>
    </header>

    <div class="container articles-hub">
        <section class="articles-hub-section" aria-labelledby="pillar-heading">
            <div class="section-head" data-enter="heading">
                <div>
                    <span class="kicker">Core Architecture Pillar</span>
                    <h2 id="pillar-heading">Master Systems Architecture</h2>
                </div>
            </div>

            <article class="card article-card article-pillar" data-enter="card" data-pointer="glow">
                <div class="article-card-meta">
                    <span class="chip chip-accent">@pillar.Category</span>
                    <span class="article-meta-text">@pillar.ReadingTime · Published @pillar.PublishedDate.ToString("MMMM yyyy", CultureInfo.InvariantCulture)</span>
                </div>

                <h3><a href="/article/@pillar.Slug">@pillar.Title</a></h3>
                <p class="summary">@pillar.Summary</p>

                @if (pillar.Highlights.Count > 0)
                {
                    <ul class="chips article-highlights" aria-label="Key Takeaways">
                        @foreach (var h in pillar.Highlights)
                        {
                            <li class="chip">✓ @h</li>
                        }
                    </ul>
                }

                <div class="article-pillar-foot">
                    <span class="article-meta-text">Focus: <code>@pillar.TargetKeyword</code></span>
                    <span class="text-link">Read Architecture Blueprint →</span>
                </div>
            </article>
        </section>

        <section class="articles-hub-section" aria-labelledby="clusters-heading">
            <div class="section-head" data-enter="heading">
                <div>
                    <span class="kicker">Topic Cluster Implementation Guides</span>
                    <h2 id="clusters-heading">Focused Systems &amp; Pipeline Tutorials</h2>
                </div>
            </div>

            <div class="article-grid" data-stagger data-pointer-each="glow">
                @foreach (var article in clusters)
                {
                    <article class="card article-card" data-enter="card">
                        <div class="article-card-meta">
                            <span class="chip">@article.Category</span>
                            <span class="article-meta-text">@article.ReadingTime</span>
                        </div>

                        <h3><a href="/article/@article.Slug">@article.Title</a></h3>
                        <p class="summary">@article.Summary</p>

                        @if (!string.IsNullOrWhiteSpace(article.TechStack))
                        {
                            <ul class="chips article-tech" aria-label="Tech">
                                @foreach (var tech in PublicSite.Csv(article.TechStack))
                                {
                                    <li class="chip">@tech</li>
                                }
                            </ul>
                        }
                    </article>
                }
            </div>
        </section>
    </div>
</div>
