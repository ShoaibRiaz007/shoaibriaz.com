@model HomeViewModel
@{
    Layout = "_SiteLayout";
    var bio = Model.Bio;
    var current = Model.ExperienceGroups.FirstOrDefault(g => g.Roles.Any(r => r.IsCurrent));
    var currentRole = current?.Roles.First(r => r.IsCurrent);
    // Only metrics led by a number ("70–80% faster ...") make the stats strip; labels belong on the cards.
    // A bare figure ("12") is captioned with its project's title.
    var proofs = Model.Projects
        .Select(p => PublicSite.ProofFigure(p.Metric) is { } f ? (f.Figure, Label: f.Label.Length > 0 ? f.Label : p.Title) : default((string Figure, string Label)?))
        .OfType<(string Figure, string Label)>().Take(2).ToList();
    var featured = Model.Projects;
    var skillGroups = Model.Skills.GroupBy(s => string.IsNullOrWhiteSpace(s.Category) ? "Skills" : s.Category).ToList();
    // Headline "Team Lead · C# / .NET · AI/LLM · ..." : the first part leads, the rest rotate after it.
    var headlineParts = PublicSite.HeadlineParts(bio.Headline);
    var rotating = headlineParts.Skip(1).ToList();
    var nameWords = (bio.FullName ?? "").Split(' ', StringSplitOptions.RemoveEmptyEntries);
    // The marquee: where I've worked, then the tools I use most.
    var marquee = Model.ExperienceGroups.Select(g => g.Company.Trim())
        .Concat(Model.Person?.Skills ?? []).Where(x => x.Length > 0)
        .Distinct(StringComparer.OrdinalIgnoreCase).Take(16).ToList();
    // Role highlights beyond this many sit behind "Show more" so the timeline stays scannable.
    const int visiblePoints = 2;
}

@* data-progress: the header's thin bar tracks how far down the page the visitor is. *@
<div data-progress>
<nav class="section-rail" aria-label="Sections on this page" data-spy="within">
    <ol>
        @if (featured.Any()) { <li><a href="#work"><span class="rail-label">Work</span></a></li> }
        @if (Model.Services.Any() && skillGroups.Any()) { <li><a href="#approach"><span class="rail-label">How I work</span></a></li> }
        @if (Model.ExperienceGroups.Any()) { <li><a href="#experience"><span class="rail-label">Experience</span></a></li> }
        @if (skillGroups.Any() || Model.Services.Any()) { <li><a href="#skills"><span class="rail-label">Skills</span></a></li> }
        <li><a href="#about"><span class="rail-label">About</span></a></li>
        <li><a href="#contact"><span class="rail-label">Contact</span></a></li>
    </ol>
</nav>

<section class="hero" data-pointer="spotlight" data-idle>
    <div class="hero-aurora" aria-hidden="true"><span></span><span></span></div>
    <div class="container hero-grid" data-scroll="lift">
        <div class="hero-copy">
            <span class="status" data-enter="hero" style="--i:0"><span class="status-dot" aria-hidden="true"></span>
                @(currentRole is null ? "Open to opportunities" : $"{currentRole.Role} at {current!.Company} · open to lead roles")
            </span>
            <h1 aria-label="@bio.FullName">
                @for (var i = 0; i < nameWords.Length; i++)
                {
                    <span class="word" aria-hidden="true" data-enter="hero" style="--i:@(i + 1)">@nameWords[i]</span>
                }
            </h1>
            @if (headlineParts.Length > 0)
            {
                <p class="headline" data-enter="hero" style="--i:3">
                    <span class="visually-hidden">@bio.Headline</span>
                    <span aria-hidden="true">@headlineParts[0]@if (rotating.Count > 0) {<text> · </text><span class="rotator" data-rotator>@foreach (var r in rotating) {<span>@r</span>}</span>}</span>
                </p>
            }
            @if (!string.IsNullOrWhiteSpace(bio.Tagline)) { <p class="tagline" data-enter="hero" style="--i:4">@bio.Tagline</p> }
            <div class="hero-actions" data-enter="hero" style="--i:5">
                <a class="btn btn-primary" href="@(featured.Any() ? "#work" : "/projects")">View work
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 5v14M5 12l7 7 7-7"/></svg>
                </a>
                @if (!string.IsNullOrWhiteSpace(bio.ResumeUrl))
                {
                    <a class="btn btn-ghost" href="@bio.ResumeUrl" target="_blank" rel="noopener">Download CV</a>
                }
                else
                {
                    <a class="btn btn-ghost" href="/cv">View CV</a>
                }
                @if (!string.IsNullOrWhiteSpace(bio.Email))
                {
                    <span class="hero-copy-email">
                        @* Hidden until public.js runs; until then (or if it never does) the Contact link stands in. *@
                        <button type="button" class="btn btn-link copy-btn" data-copy="@bio.Email">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="9" y="9" width="11" height="11" rx="2"/><path d="M5 15V5a2 2 0 0 1 2-2h10"/></svg>
                            <span data-copy-label>Copy email</span>
                        </button>
                        <span class="visually-hidden" role="status" aria-live="polite" data-copy-status></span>
                    </span>
                }
                <a class="btn btn-link contact-fallback" href="#contact">Contact <span aria-hidden="true">→</span></a>
            </div>
            <div class="hero-meta" data-enter="hero" style="--i:6">
                @if (!string.IsNullOrWhiteSpace(bio.Location))
                {
                    <span class="hero-loc">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 21s7-6.2 7-12a7 7 0 0 0-14 0c0 5.8 7 12 7 12z"/><circle cx="12" cy="9" r="2.5"/></svg>
                        @bio.Location · remote, hybrid or on-site
                    </span>
                }
                <ul class="socials" aria-label="Elsewhere">
                    @if (!string.IsNullOrWhiteSpace(bio.LinkedIn))
                    {
                        <li><a class="icon-btn" href="@bio.LinkedIn" target="_blank" rel="me noopener" aria-label="LinkedIn (opens in a new tab)">
                            <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M4.98 3.5a2.5 2.5 0 1 1 0 5 2.5 2.5 0 0 1 0-5zM3 9.75h4V21H3zM9.5 9.75h3.8v1.6h.06c.53-1 1.83-2.05 3.77-2.05 4.03 0 4.77 2.65 4.77 6.1V21h-4v-4.9c0-1.17-.02-2.68-1.63-2.68-1.64 0-1.89 1.28-1.89 2.6V21h-4z"/></svg>
                        </a></li>
                    }
                    @if (!string.IsNullOrWhiteSpace(bio.GitHub))
                    {
                        <li><a class="icon-btn" href="@bio.GitHub" target="_blank" rel="me noopener" aria-label="GitHub (opens in a new tab)">
                            <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2a10 10 0 0 0-3.16 19.49c.5.09.68-.22.68-.48v-1.7c-2.78.6-3.37-1.34-3.37-1.34-.45-1.16-1.11-1.47-1.11-1.47-.91-.62.07-.6.07-.6 1 .07 1.53 1.03 1.53 1.03.9 1.52 2.34 1.08 2.91.83.09-.65.35-1.09.63-1.34-2.22-.25-4.55-1.11-4.55-4.94 0-1.09.39-1.98 1.03-2.68-.1-.25-.45-1.27.1-2.64 0 0 .84-.27 2.75 1.02a9.56 9.56 0 0 1 5 0c1.91-1.29 2.75-1.02 2.75-1.02.55 1.37.2 2.39.1 2.64.64.7 1.03 1.59 1.03 2.68 0 3.84-2.34 4.68-4.57 4.93.36.31.68.92.68 1.85v2.74c0 .27.18.58.69.48A10 10 0 0 0 12 2z"/></svg>
                        </a></li>
                    }
                    @if (!string.IsNullOrWhiteSpace(bio.Email))
                    {
                        <li><a class="icon-btn" href="mailto:@bio.Email" aria-label="Email @bio.Email">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3 7l9 6 9-6"/></svg>
                        </a></li>
                    }
                </ul>
            </div>
        </div>
        <div class="hero-side" data-enter="hero" style="--i:2">
            <div class="avatar-wrap" data-scroll="recede">
                @if (!string.IsNullOrWhiteSpace(bio.ProfileImageUrl))
                {
                    <img class="avatar" src="@bio.ProfileImageUrl" alt="Portrait of @bio.FullName" width="260" height="260" fetchpriority="high" />
                }
                else
                {
                    <div class="avatar avatar-fallback" aria-hidden="true">@PublicSite.Initials(bio)</div>
                }
            </div>
        </div>
    </div>
    <a class="scroll-cue" data-scroll="fade" href="@(featured.Any() ? "#work" : Model.ExperienceGroups.Any() ? "#experience" : "#about")" aria-label="Scroll to the next section">
        <span class="scroll-cue-mouse" aria-hidden="true"><span></span></span>
        <span class="scroll-cue-text" aria-hidden="true">Scroll</span>
    </a>
</section>


@if (!string.IsNullOrWhiteSpace(bio.YearsExperience) || Model.TotalProjects > 0 || proofs.Count > 0)
{
    <div class="container">
        <ul class="proof" data-enter="widen" aria-label="Highlights">
            @if (!string.IsNullOrWhiteSpace(bio.YearsExperience))
            {
                <li class="proof-item"><strong data-count>@bio.YearsExperience</strong><span>years building with C#, .NET and Unity</span></li>
            }
            @if (Model.TotalProjects > 0)
            {
                <li class="proof-item"><strong data-count>@Model.TotalProjects</strong><span>projects shipped</span></li>
            }
            @foreach (var (figure, label) in proofs)
            {
                <li class="proof-item"><strong data-count>@figure</strong><span>@label</span></li>
            }
        </ul>
    </div>
}

@if (marquee.Count > 0)
{
    <div class="marquee-wrap" role="group" aria-label="Companies and tools" data-velocity data-pausable data-idle>
        <div class="marquee">
            <ul class="marquee-track">
                @foreach (var m in marquee) { <li>@m</li> }
            </ul>
            @* A second copy makes the loop seamless; it's decoration, so assistive tech skips it. *@
            <ul class="marquee-track" aria-hidden="true">
                @foreach (var m in marquee) { <li>@m</li> }
            </ul>
        </div>
        @* Shown by public.js: content that keeps moving needs a way to stop it. *@
        <button type="button" class="icon-btn marquee-toggle" data-pause aria-pressed="false" aria-label="Pause the moving list" hidden>
            <svg class="icon-pause" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M7 5h3v14H7zM14 5h3v14h-3z"/></svg>
            <svg class="icon-play" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M8 5v14l11-7z"/></svg>
        </button>
    </div>
}

@if (featured.Any())
{
    <section class="section" id="work" aria-labelledby="work-title">
        <div class="container">
            <div class="section-head" data-enter="heading">
                <div>
                    <span class="kicker">Selected work</span>
                    <h2 id="work-title">Case studies</h2>
                    <p>What I built, the problem it solved and what changed because of it.</p>
                </div>
                @if (Model.TotalProjects > featured.Count)
                {
                    <a class="text-link arrow-link" href="/projects">All @Model.TotalProjects projects <span aria-hidden="true">→</span></a>
                }
            </div>
            <div class="project-grid featured-grid" data-stagger data-pointer-each="tilt" data-badge="View case study →">
                @foreach (var p in featured) { <partial name="_ProjectCard" model="p" view-data="@(new ViewDataDictionary(ViewData) { ["Enter"] = "deal" })" /> }
            </div>
        </div>
    </section>
}

@if (Model.Services.Any())
{
    @* The header's Skills link points at #skills; with no skills listed, this section answers it. *@
    <section class="section" id="@(skillGroups.Any() ? "approach" : "skills")" aria-labelledby="approach-title">
        <div class="container">
            <div class="section-head" data-enter="heading">
                <div>
                    <span class="kicker">How I work</span>
                    <h2 id="approach-title">What I bring to a team</h2>
                </div>
            </div>
            <div class="services" data-stagger data-pointer-each="glow">
                @foreach (var s in Model.Services)
                {
                    <div class="card service" data-enter="card">
                        @if (!string.IsNullOrWhiteSpace(s.Icon)) { <span class="icon" aria-hidden="true" data-enter-item="spin">@s.Icon</span> }
                        <h3>@s.Title</h3>
                        <p>@s.Description</p>
                    </div>
                }
            </div>
        </div>
    </section>
}

@if (Model.ExperienceGroups.Any())
{
    <section class="section" id="experience" aria-labelledby="exp-title">
        <div class="container">
            <div class="section-head" data-enter="heading">
                <div>
                    <span class="kicker">Experience</span>
                    <h2 id="exp-title">Where I've worked</h2>
                </div>
                <a class="text-link arrow-link" href="/cv">Full CV <span aria-hidden="true">→</span></a>
            </div>
            <ol class="timeline" data-hover-focus>
                @foreach (var g in Model.ExperienceGroups)
                {
                    <li class="card company" data-enter="slide-left">
                        <div class="company-meta">
                            <h3>@g.Company</h3>
                            <p class="period">@g.Period</p>
                        </div>
                        <ol class="roles @(g.Roles.Count > 1 ? "multi" : "")" data-scroll="@(g.Roles.Count > 1 ? "draw" : null)">
                            @foreach (var r in g.Roles)
                            {
                                var points = PublicSite.Lines(r.Description);
                                <li class="role @(r.IsCurrent ? "current" : "")" data-enter-item="@(g.Roles.Count > 1 ? "dot" : null)">
                                    <h4>@r.Role</h4>
                                    <p class="role-meta">@string.Join(" · ", new[] { r.Period, r.EmploymentType, r.Location }.Where(x => !string.IsNullOrWhiteSpace(x)))</p>
                                    @if (points.Length > 0)
                                    {
                                        <ul>@foreach (var pt in points.Take(visiblePoints)) { <li>@pt</li> }</ul>
                                    }
                                    @if (points.Length > visiblePoints)
                                    {
                                        @* Native <details>: collapsible with or without JS. *@
                                        <details class="more">
                                            <summary><span class="when-closed">Show @(points.Length - visiblePoints) more</span><span class="when-open">Show less</span></summary>
                                            <ul>@foreach (var pt in points.Skip(visiblePoints)) { <li>@pt</li> }</ul>
                                        </details>
                                    }
                                </li>
                            }
                        </ol>
                    </li>
                }
            </ol>
        </div>
    </section>
}

@if (skillGroups.Any())
{
    <section class="section" id="skills" aria-labelledby="skills-title">
        <div class="container">
            <div class="section-head" data-enter="heading">
                <div>
                    <span class="kicker">Skills</span>
                    <h2 id="skills-title">What I work with</h2>
                </div>
            </div>
            <div class="skill-groups" data-stagger data-hover-focus>
                @foreach (var g in skillGroups)
                {
                    <div class="card skill-group" data-enter="flip">
                        <h3>@g.Key</h3>
                        <ul class="chips">@foreach (var s in g) { <li class="chip" data-enter-item="pop">@s.Name</li> }</ul>
                    </div>
                }
            </div>
        </div>
    </section>
}

<section class="section island-section" aria-labelledby="island-title">
    <div class="container">
        <a class="card island-teaser" data-enter="card" data-pointer="lean" data-idle href="/world/" aria-labelledby="island-title">
            <div class="island-copy">
                <span class="kicker">Something different</span>
                <h2 id="island-title">Explore my career as a 3D island</h2>
                <p class="muted">Walk the career trail, read the journal, sit by the campfire. Runs in the browser; keyboard and touch work.</p>
                <span class="btn btn-ghost island-cta">Visit the island <span aria-hidden="true">→</span></span>
            </div>
            <svg class="island-art" data-lean viewBox="0 0 320 200" aria-hidden="true">
                <g data-scroll="depth-far"><circle class="ia-sun" cx="248" cy="52" r="22"/></g>
                <path class="ia-wave ia-wave-2" d="M0 158c27 0 27-8 53-8s27 8 53 8 27-8 53-8 27 8 54 8 26-8 53-8 27 8 54 8v42H0z"/>
                <g data-scroll="depth-near"><path class="ia-land" d="M70 156c14-30 44-44 90-44s78 16 92 44z"/><path class="ia-tree" d="M150 116v-38m0 0c-10-10-26-9-32 0m32 0c10-10 26-9 32 0m-32 0c-4-12-16-18-26-14m26 14c4-12 16-18 26-14"/></g>
                <path class="ia-wave ia-wave-1" d="M0 170c27 0 27-8 53-8s27 8 53 8 27-8 53-8 27 8 54 8 26-8 53-8 27 8 54 8v30H0z"/>
            </svg>
        </a>
    </div>
</section>

<section class="section" id="about" aria-labelledby="about-title">
    <div class="container">
        <div class="section-head" data-enter="heading">
            <div>
                <span class="kicker">About</span>
                <h2 id="about-title">A bit more about me</h2>
            </div>
        </div>
        <div class="about">
            <div class="prose" data-enter>
                @foreach (var para in PublicSite.Lines(bio.About)) { <p>@para</p> }
            </div>
            <ul class="facts" data-enter="slide-right">
                @if (!string.IsNullOrWhiteSpace(bio.Location)) { <li><span>Based in</span><span>@bio.Location</span></li> }
                @if (!string.IsNullOrWhiteSpace(bio.YearsExperience)) { <li><span>Experience</span><span>@bio.YearsExperience years</span></li> }
                @if (currentRole is not null) { <li><span>Currently</span><span>@currentRole.Role, @current!.Company</span></li> }
                @foreach (var e in Model.Educations)
                {
                    <li><span>Education</span><span>@string.Join(", ", new[] { e.Degree, e.FieldOfStudy }.Where(x => !string.IsNullOrWhiteSpace(x))) — @e.Institution</span></li>
                }
            </ul>
        </div>

        @if (Model.Certifications.Any())
        {
            <h3 class="kicker subhead">Certifications</h3>
            <ul class="cred-list two-col" data-stagger>
                @foreach (var c in Model.Certifications)
                {
                    <li class="card cred" data-enter>
                        <div>
                            <h3>@c.Name</h3>
                            <p class="muted">@c.Issuer@(c.IssuedOn is null ? "" : " · " + c.IssuedOn.Value.ToString("MMM yyyy", CultureInfo.InvariantCulture))</p>
                        </div>
                        @if (!string.IsNullOrWhiteSpace(c.CredentialUrl))
                        {
                            <a class="text-link" href="@c.CredentialUrl" target="_blank" rel="noopener" aria-label="Verify @c.Name">Verify ↗</a>
                        }
                    </li>
                }
            </ul>
        }
    </div>
</section>

@if (Model.Testimonials.Any())
{
    <section class="section" aria-labelledby="quotes-title">
        <div class="container">
            <div class="section-head" data-enter="heading"><div><span class="kicker">Kind words</span><h2 id="quotes-title">What people say</h2></div></div>
            <div class="two-col" data-stagger>
                @foreach (var (t, n) in Model.Testimonials.Select((t, n) => (t, n)))
                {
                    <figure class="card quote" data-enter="@(n % 2 == 0 ? "tilt-left" : "tilt-right")">
                        <blockquote>“@t.Quote”</blockquote>
                        <figcaption><strong>@t.Author</strong>@(string.IsNullOrWhiteSpace(t.AuthorTitle) ? "" : $" — {t.AuthorTitle}")</figcaption>
                    </figure>
                }
            </div>
        </div>
    </section>
}

<section class="section" id="contact" aria-labelledby="contact-title">
    <div class="container">
        <div class="card contact-band" data-enter="card" data-pointer="spotlight" data-pointer-area>
            <div>
                <span class="kicker">Contact</span>
                <h2 id="contact-title">Let's build something.</h2>
                <p class="muted contact-note">Open to senior and lead roles and interesting contracts: remote, hybrid or on-site.</p>
                @if (!string.IsNullOrWhiteSpace(bio.Email))
                {
                    <p class="contact-email">
                        <a href="mailto:@bio.Email">@bio.Email</a>
                        @* Hidden until public.js runs; without JS the mailto link above is the way in. *@
                        <button type="button" class="btn btn-ghost btn-sm copy-btn" data-copy="@bio.Email">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="9" y="9" width="11" height="11" rx="2"/><path d="M5 15V5a2 2 0 0 1 2-2h10"/></svg>
                            <span data-copy-label>Copy email</span>
                        </button>
                        <span class="visually-hidden" role="status" aria-live="polite" data-copy-status></span>
                    </p>
                }
                <p class="muted contact-privacy">This site keeps only anonymous, cookie-free visit counts. <a href="/privacy">Privacy</a></p>
            </div>
            <div class="hero-actions flush">
                @if (!string.IsNullOrWhiteSpace(bio.Email)) { <a class="btn btn-primary" data-pointer="magnet" href="mailto:@bio.Email">Email me</a> }
                @if (!string.IsNullOrWhiteSpace(bio.LinkedIn)) { <a class="btn btn-ghost" href="@bio.LinkedIn" target="_blank" rel="me noopener">LinkedIn ↗</a> }
            </div>
        </div>
    </div>
</section>
</div>
