@model ArticleDetailViewModel
@{
    Layout = "_SiteLayout";
    var bio = Model.Bio;
    var article = Model.Article;
    var pillar = Model.PillarArticle;
    var related = Model.RelatedArticles;

    var headings = Model.Blocks.OfType<RichText.Heading>().Select(h => h.Text).ToList();
}

<article data-progress>
    <header class="cs-hero" data-pointer="spotlight">
        <div class="container cs-hero-text">
            <nav aria-label="Breadcrumb" data-enter="hero" style="--i:0">
                <ol class="breadcrumb">
                    <li><a href="/">Home</a></li>
                    <li><a href="/articles">Articles</a></li>
                    @if (pillar is not null)
                    {
                        <li><a href="/article/@pillar.Slug">@pillar.Category</a></li>
                    }
                    <li><span aria-current="page">@article.Title</span></li>
                </ol>
            </nav>

            <div class="article-hero-meta" data-enter="hero" style="--i:1">
                <span class="chip chip-accent">@article.Category</span>
                <span class="article-meta-text">@article.ReadingTime · Published @article.PublishedDate.ToString("MMMM d, yyyy", CultureInfo.InvariantCulture)</span>
            </div>

            <h1 data-enter="hero" style="--i:2">@article.Title</h1>
            <p class="lede" data-enter="hero" style="--i:3">@article.Summary</p>

            @if (!string.IsNullOrWhiteSpace(article.TechStack))
            {
                <div class="hero-actions" data-enter="hero" style="--i:4">
                    <ul class="chips" aria-label="Tech Stack">
                        @foreach (var tech in PublicSite.Csv(article.TechStack))
                        {
                            <li class="chip">@tech</li>
                        }
                    </ul>
                </div>
            }
        </div>
    </header>

    <div class="container article-page">
        <div class="article-layout @(headings.Count == 0 ? "article-layout-single" : "")">
            @if (headings.Count > 0)
            {
                <aside class="article-sidebar" aria-label="Table of Contents">
                    <div class="card article-sidebar-card">
                        <h4 class="article-toc-title">On This Page</h4>
                        <ul class="article-toc">
                            @foreach (var h in headings)
                            {
                                <li>
                                    <a href="#@RichText.HeadingId(h)">@h</a>
                                </li>
                            }
                        </ul>
                    </div>
                </aside>
            }

            <div class="article-content">
                @if (article.Highlights.Count > 0)
                {
                    <div class="card article-takeaways" data-enter="card">
                        <h3 class="article-takeaways-title">Key Engineering Takeaways</h3>
                        <ul class="chips" aria-label="Key Takeaways">
                            @foreach (var h in article.Highlights)
                            {
                                <li class="chip chip-accent">✓ @h</li>
                            }
                        </ul>
                    </div>
                }

                <div class="article-prose">
                    <partial name="_RichText" model="Model.Blocks" />
                </div>

                <section class="article-cluster-nav" aria-labelledby="topic-cluster-heading">
                    <h3 id="topic-cluster-heading" class="article-section-title">Topic Cluster Navigation</h3>

                    @if (pillar is not null)
                    {
                        <article class="card article-card article-pillar" data-pointer="glow">
                            <div class="article-card-meta">
                                <span class="chip chip-accent">Parent Architecture Blueprint</span>
                                <span class="article-meta-text">@pillar.ReadingTime</span>
                            </div>
                            <h4><a href="/article/@pillar.Slug">@pillar.Title</a></h4>
                            <p class="summary">@pillar.Summary</p>
                        </article>
                    }

                    <div class="article-related-grid" data-pointer-each="glow">
                        @foreach (var rel in related)
                        {
                            <article class="card article-card">
                                <div class="article-card-meta">
                                    <span class="chip">@rel.Category</span>
                                    <span class="article-meta-text">@rel.ReadingTime</span>
                                </div>
                                <h4><a href="/article/@rel.Slug">@rel.Title</a></h4>
                                <p class="summary">@rel.Summary</p>
                            </article>
                        }
                    </div>
                </section>

                <div class="card article-author-box">
                    <div>
                        <span class="kicker">About the Author</span>
                        <h4>@bio.FullName</h4>
                        <p class="muted">@bio.Tagline</p>
                        <div class="hero-actions article-author-actions">
                            <a href="/#contact" class="btn btn-ghost btn-sm">Get in Touch</a>
                            <a href="/cv" class="btn btn-ghost btn-sm">View Experience / CV</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</article>
