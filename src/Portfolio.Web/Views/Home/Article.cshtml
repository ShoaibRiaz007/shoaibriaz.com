@model ArticleDetailViewModel
@{
    Layout = "_SiteLayout";
    var bio = Model.Bio;
    var article = Model.Article;
    var pillar = Model.PillarArticle;
    var related = Model.RelatedArticles;
    var tech = PublicSite.Csv(article.TechStack);
    var headings = Model.Blocks.OfType<RichText.Heading>().Select(h => (Id: RichText.HeadingId(h.Text), Text: h.Text)).ToList();
}

<article data-progress>
    <header class="cs-hero" data-pointer="spotlight">
        <div class="container cs-hero-text">
            <nav aria-label="Breadcrumb" data-enter="hero" style="--i:0">
                <ol class="breadcrumb">
                    <li><a href="/">Home</a></li>
                    <li><a href="/articles">Articles</a></li>
                    @if (pillar is not null)
                    {
                        <li><a href="/article/@pillar.Slug">@pillar.Category</a></li>
                    }
                    <li><span aria-current="page">@article.Title</span></li>
                </ol>
            </nav>

            <div class="article-hero-meta" data-enter="hero" style="--i:1">
                <span class="chip chip-accent">@article.Category</span>
                <span class="article-meta-text">@article.ReadingTime · Published @article.PublishedDate.ToString("MMMM d, yyyy", CultureInfo.InvariantCulture)</span>
            </div>

            <h1 data-enter="hero" style="--i:2">@article.Title</h1>
            <p class="lede" data-enter="hero" style="--i:3">@article.Summary</p>
        </div>
    </header>

    <div class="container cs-layout article-page">
        <div class="cs-main article-content">
            @if (article.Highlights.Count > 0)
            {
                <div class="card article-takeaways" data-enter="card">
                    <h2 class="article-takeaways-title">Key Engineering Takeaways</h2>
                    <ul class="chips" aria-label="Key Takeaways">
                        @foreach (var h in article.Highlights)
                        {
                            <li class="chip chip-accent">✓ @h</li>
                        }
                    </ul>
                </div>
            }

            <div class="article-prose">
                <partial name="_RichText" model="Model.Blocks" />
            </div>

            <section class="article-cluster-nav" aria-labelledby="topic-cluster-heading">
                <h2 id="topic-cluster-heading" class="article-section-title">Topic Cluster Navigation</h2>

                @if (pillar is not null)
                {
                    <partial name="_ArticleCard" model="pillar" view-data="@(new ViewDataDictionary(ViewData) { ["AsPillar"] = true, ["Badge"] = "Parent Architecture Blueprint", ["MaxTech"] = 0, ["PointerGlow"] = true })" />
                }

                @if (related.Any())
                {
                    <div class="article-related-grid" data-stagger data-pointer-each="glow">
                        @foreach (var rel in related)
                        {
                            <partial name="_ArticleCard" model="rel" view-data="@(new ViewDataDictionary(ViewData) { ["MaxTech"] = 0 })" />
                        }
                    </div>
                }
            </section>

            <div class="card article-author-box">
                <div>
                    <span class="kicker">About the Author</span>
                    <h3>@bio.FullName</h3>
                    <p class="muted">@bio.Tagline</p>
                    <div class="hero-actions article-author-actions">
                        <a href="/#contact" class="btn btn-ghost btn-sm">Get in Touch</a>
                        <a href="/cv" class="btn btn-ghost btn-sm">View Experience / CV</a>
                    </div>
                </div>
            </div>
        </div>

        <aside data-stagger>
            @if (headings.Count > 0)
            {
                <nav class="card side-card toc" aria-label="On this page" data-spy data-enter="slide-right">
                    <h2 class="side-title">On this page</h2>
                    <ol>
                        @foreach (var (id, text) in headings)
                        {
                            <li><a href="#@id">@text</a></li>
                        }
                    </ol>
                </nav>
            }
            @if (tech.Length > 0)
            {
                <div class="card side-card" data-enter="slide-right">
                    <h2 class="side-title">Tech stack</h2>
                    <ul class="chips">@foreach (var t in tech) { <li class="chip" data-enter-item="pop">@t</li> }</ul>
                </div>
            }
            <div class="card side-card" data-enter="slide-right" data-pointer-area>
                <h2 class="side-title">Architecture consulting</h2>
                <p class="muted side-note">Building something similar?</p>
                @if (!string.IsNullOrWhiteSpace(bio.Email))
                {
                    <a class="btn btn-ghost btn-sm" data-pointer="magnet" href="mailto:@bio.Email">Get in touch</a>
                }
                else
                {
                    <a class="btn btn-ghost btn-sm" data-pointer="magnet" href="/#contact">Get in touch</a>
                }
            </div>
        </aside>
    </div>
</article>
