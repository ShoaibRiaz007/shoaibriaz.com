@model ArticleDetailViewModel
@{
    Layout = "_SiteLayout";
    var bio = Model.Bio;
    var article = Model.Article;
    var pillar = Model.PillarArticle;
    var related = Model.RelatedArticles;

    // Collect headings for Table of Contents
    var headings = Model.Blocks.OfType<RichText.Heading>().Select(h => h.Text).ToList();
}

<article data-progress>
    <header class="cs-hero" data-pointer="spotlight">
        <div class="container cs-hero-text">
            <nav aria-label="Breadcrumb" data-enter="hero" style="--i:0">
                <ol class="breadcrumb">
                    <li><a href="/">Home</a></li>
                    <li><a href="/articles">Articles</a></li>
                    @if (pillar is not null)
                    {
                        <li><a href="/article/@pillar.Slug">@pillar.Category</a></li>
                    }
                    <li><span aria-current="page">@article.Title</span></li>
                </ol>
            </nav>

            <div data-enter="hero" style="--i:1" class="mb-3">
                <span class="chip" style="background: var(--accent-soft); color: var(--accent); font-weight: 600;">@article.Category</span>
                <span class="text-dim text-sm ml-2">@article.ReadingTime · Published @article.PublishedDate.ToString("MMMM d, yyyy")</span>
            </div>

            <h1 data-enter="hero" style="--i:2">@article.Title</h1>
            <p class="lede" data-enter="hero" style="--i:3">@article.Summary</p>

            @if (!string.IsNullOrWhiteSpace(article.TechStack))
            {
                <div class="hero-actions" data-enter="hero" style="--i:4">
                    <ul class="chips" aria-label="Tech Stack">
                        @foreach (var tech in article.TechStack.Split(',', StringSplitOptions.TrimEntries))
                        {
                            <li class="chip">@tech</li>
                        }
                    </ul>
                </div>
            }
        </div>
    </header>

    <div class="container py-8">
        <div class="article-layout">
            @* Sidebar / Table of Contents *@
            @if (headings.Count > 0)
            {
                <aside class="article-sidebar" aria-label="Table of Contents">
                    <div class="card p-4 sticky top-24">
                        <h4 class="text-xs uppercase tracking-wider text-dim font-bold mb-3">On This Page</h4>
                        <ul class="text-sm space-y-2">
                            @foreach (var h in headings)
                            {
                                <li>
                                    <a href="#@h.ToLowerInvariant().Replace(' ', '-')" class="text-dim hover:text-white">@h</a>
                                </li>
                            }
                        </ul>
                    </div>
                </aside>
            }

            @* Main Article Body *@
            <div class="article-content">
                @if (article.Highlights.Count > 0)
                {
                    <div class="card p-5 mb-8" style="border-left: 4px solid var(--accent);" data-enter="card">
                        <h3 class="text-sm font-bold uppercase tracking-wider text-accent mb-2">Key Engineering Takeaways</h3>
                        <ul class="chips" style="gap: 0.5rem;">
                            @foreach (var h in article.Highlights)
                            {
                                <li class="chip" style="background: rgba(42, 214, 168, 0.08);">✓ @h</li>
                            }
                        </ul>
                    </div>
                }

                <div class="prose max-w-none">
                    <partial name="_RichText" model="Model.Blocks" />
                </div>

                @* Cluster Navigator *@
                <section class="mt-12 pt-8 border-t border-border" aria-labelledby="topic-cluster-heading">
                    <h3 id="topic-cluster-heading" class="text-xl font-bold mb-4">Topic Cluster Navigation</h3>

                    @if (pillar is not null)
                    {
                        <div class="card p-5 mb-6" style="background: var(--bg-raised);" data-pointer="glow">
                            <span class="text-xs uppercase text-accent font-bold">Parent Architecture Blueprint</span>
                            <h4 class="text-lg font-bold mt-1 mb-2">
                                <a href="/article/@pillar.Slug" class="hover:underline">@pillar.Title</a>
                            </h4>
                            <p class="text-dim text-sm mb-3">@pillar.Summary</p>
                            <a href="/article/@pillar.Slug" class="btn btn-primary btn-sm">Read Core Pillar Blueprint →</a>
                        </div>
                    }

                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                        @foreach (var rel in related)
                        {
                            <div class="card p-4" data-pointer="glow">
                                <span class="chip text-xs mb-2">@rel.Category</span>
                                <h5 class="font-bold text-sm mb-1">
                                    <a href="/article/@rel.Slug" class="hover:underline">@rel.Title</a>
                                </h5>
                                <p class="text-xs text-dim mb-2">@rel.ReadingTime</p>
                                <a href="/article/@rel.Slug" class="text-xs text-accent hover:underline">Read Guide →</a>
                            </div>
                        }
                    </div>
                </section>

                @* Author Bio Box *@
                <div class="card p-6 mt-12 flex flex-col md:flex-row items-center gap-6" style="background: var(--bg-sunken);">
                    <div>
                        <span class="text-xs uppercase text-dim tracking-wider font-bold">About the Author</span>
                        <h4 class="text-lg font-bold mt-1">@bio.FullName</h4>
                        <p class="text-dim text-sm my-2">@bio.Tagline</p>
                        <div class="flex gap-3 text-sm">
                            <a href="/#contact" class="btn btn-ghost btn-sm">Get in Touch</a>
                            <a href="/cv" class="btn btn-ghost btn-sm">View Experience / CV</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</article>
