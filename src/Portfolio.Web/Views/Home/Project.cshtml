@model ProjectDetailViewModel
@{
    Layout = "_SiteLayout";
    var p = Model.Project;
    var tech = PublicSite.Csv(p.TechStack);
    var highlights = PublicSite.Lines(p.Highlights);
    // Gallery order is the order set in the admin.
    var images = Model.Media.Where(m => m.MediaType == "image").ToList();
    var videos = Model.Media.Where(m => m.MediaType is "video" or "embed").ToList();
    var hasMedia = videos.Any() || images.Any();
    var featured = videos.FirstOrDefault();
    var moreVideos = videos.Skip(1).ToList();
    var area = PublicSite.AreaOf(p);
    var areaSlug = PublicSite.AreaSlug(area);
    // The hero shows the cover, or the generated area art when there is none: the same image as the project's card.
    var cover = string.IsNullOrWhiteSpace(p.ImageUrl) ? null : p.ImageUrl;
    var coverInGallery = cover is not null && images.Any(i => i.Url == cover);
    var hasOverview = PublicSite.Lines(p.Description).Length > 0;
    var story = new (string Id, string Title, string Text)[]
    {
        ("challenge", "The challenge", p.Challenge), ("solution", "What I built", p.Solution), ("outcome", "Outcome", p.Outcome),
    }.Where(s => PublicSite.Lines(s.Text).Length > 0).ToList();
    // "On this page" entries, in render order; only worth showing for a long case study.
    var toc = new List<(string Id, string Title)>();
    if (highlights.Length > 0) toc.Add(("highlights", "Highlights"));
    if (hasOverview) toc.Add(("overview", "Overview"));
    if (hasMedia) toc.Add(("gallery", "See it in action"));
    toc.AddRange(story.Select(s => (s.Id, s.Title)));
    var mediaSummary = string.Join(" · ", new[]
    {
        videos.Count > 0 ? $"{videos.Count} video{(videos.Count == 1 ? "" : "s")}" : null,
        images.Count > 0 ? $"{images.Count} screenshot{(images.Count == 1 ? "" : "s")}" : null,
    }.Where(x => x is not null));
    string VideoTitle(ProjectMedia v) => string.IsNullOrWhiteSpace(v.Caption) ? p.Title + " video" : v.Caption;
}
<article data-progress>
    <header class="cs-hero">
        <div class="container cs-hero-grid">
            <div class="cs-hero-text">
                <nav aria-label="Breadcrumb" data-enter="hero" style="--i:0">
                    <ol class="breadcrumb">
                        <li><a href="/">Home</a></li>
                        <li><a href="/projects">Work</a></li>
                        <li><a href="/projects?area=@areaSlug">@area</a></li>
                        <li><span aria-current="page">@p.Title</span></li>
                    </ol>
                </nav>
                <h1 data-enter="hero" style="--i:1">@p.Title</h1>
                @if (!string.IsNullOrWhiteSpace(p.Summary)) { <p class="lede" data-enter="hero" style="--i:2">@p.Summary</p> }
                @if (!string.IsNullOrWhiteSpace(p.ProjectUrl) || !string.IsNullOrWhiteSpace(p.GitHubUrl) || hasMedia)
                {
                    <div class="hero-actions" data-enter="hero" style="--i:3">
                        @if (featured is not null)
                        {
                            <a class="btn btn-primary" href="#gallery"><span aria-hidden="true">▶</span> Watch the demo</a>
                        }
                        @if (!string.IsNullOrWhiteSpace(p.ProjectUrl))
                        {
                            <a class="btn @(featured is null ? "btn-primary" : "btn-ghost")" href="@p.ProjectUrl" target="_blank" rel="noopener">Live project <span aria-hidden="true">↗</span><span class="visually-hidden">(opens in a new tab)</span></a>
                        }
                        @if (!string.IsNullOrWhiteSpace(p.GitHubUrl))
                        {
                            <a class="btn btn-ghost" href="@p.GitHubUrl" target="_blank" rel="noopener">Source code <span aria-hidden="true">↗</span><span class="visually-hidden">(opens in a new tab)</span></a>
                        }
                        @if (featured is null && images.Any())
                        {
                            <a class="btn btn-ghost" href="#gallery">See @images.Count screenshot@(images.Count == 1 ? "" : "s")</a>
                        }
                    </div>
                }
            </div>
            <figure class="cs-cover" data-scroll="recede" style="view-transition-name: cover-@p.Slug">
                @if (cover is null)
                {
                    <div class="art art-@areaSlug art-v@(PublicSite.Variant(p.Slug))" aria-hidden="true">
                        <span class="art-glyph"><partial name="_AreaGlyph" model="areaSlug" /></span>
                        <span class="art-label">@area</span>
                    </div>
                }
                else if (coverInGallery)
                {
                    <button type="button" class="cs-cover-button" data-lightbox-open="@cover" aria-label="View the cover image full size">
                        <img src="@cover" alt="@p.Title" decoding="async" fetchpriority="high" />
                    </button>
                }
                else
                {
                    <img src="@cover" alt="@p.Title" decoding="async" fetchpriority="high" />
                }
            </figure>
            <dl class="cs-facts" data-enter="hero" style="--i:4">
                @if (!string.IsNullOrWhiteSpace(p.Metric)) { <div><dt>Result</dt><dd class="metric">@p.Metric</dd></div> }
                @if (!string.IsNullOrWhiteSpace(p.MyRole)) { <div><dt>Role</dt><dd>@p.MyRole</dd></div> }
                @if (!string.IsNullOrWhiteSpace(p.Timeline)) { <div><dt>When</dt><dd>@p.Timeline</dd></div> }
                @if (!string.IsNullOrWhiteSpace(p.Category)) { <div><dt>Area</dt><dd>@p.Category</dd></div> }
            </dl>
        </div>
    </header>

    <div class="container cs-layout">
        <div class="cs-main">
            @if (highlights.Length > 0)
            {
                <section class="cs-block" id="highlights" aria-labelledby="highlights-title" data-enter>
                    <h2 id="highlights-title">Highlights</h2>
                    <ul class="cs-highlights">@foreach (var h in highlights) { <li data-enter-item="slide-right">@h</li> }</ul>
                </section>
            }
            @if (hasOverview)
            {
                <section class="cs-block" id="overview" aria-labelledby="overview-title" data-enter>
                    <h2 id="overview-title">Overview</h2>
                    @foreach (var para in PublicSite.Lines(p.Description)) { <p>@para</p> }
                </section>
            }
            @if (hasMedia)
            {
                <section class="cs-block cs-media" id="gallery" aria-labelledby="gallery-title">
                    <div class="cs-media-head" data-enter>
                        <h2 id="gallery-title">See it in action</h2>
                        <p class="muted">@mediaSummary</p>
                    </div>
                    @if (featured is not null)
                    {
                        <figure class="video-featured" data-enter="card">
                            <partial name="_VideoFrame" model="@(new VideoFrameModel(featured, VideoTitle(featured)))" />
                            @if (!string.IsNullOrWhiteSpace(featured.Caption)) { <figcaption>@featured.Caption</figcaption> }
                        </figure>
                    }
                    @if (moreVideos.Any())
                    {
                        <div class="videos" data-stagger>
                            @foreach (var v in moreVideos)
                            {
                                <figure data-enter="card">
                                    <partial name="_VideoFrame" model="@(new VideoFrameModel(v, VideoTitle(v)))" />
                                    @if (!string.IsNullOrWhiteSpace(v.Caption)) { <figcaption>@v.Caption</figcaption> }
                                </figure>
                            }
                        </div>
                    }
                    @if (images.Any())
                    {
                        <div class="gallery" data-stagger>
                            @foreach (var img in images)
                            {
                                var alt = string.IsNullOrWhiteSpace(img.Caption) ? $"{p.Title} screenshot" : img.Caption;
                                <figure data-enter="card">
                                    <button type="button" data-lightbox="@img.Url" data-alt="@alt" aria-label="View full size: @alt">
                                        <img src="@img.Url" alt="@alt" loading="lazy" decoding="async" />
                                        <span class="gallery-zoom" aria-hidden="true">⤢</span>
                                    </button>
                                    @if (!string.IsNullOrWhiteSpace(img.Caption)) { <figcaption>@img.Caption</figcaption> }
                                </figure>
                            }
                        </div>
                        <p class="gallery-hint muted">Select a screenshot to view it full size; the arrow keys move between them.</p>
                    }
                </section>
            }
            @foreach (var (id, title, text) in story)
            {
                <section class="cs-block" id="@id" aria-labelledby="@(id)-title" data-enter>
                    <h2 id="@(id)-title">@title</h2>
                    @foreach (var para in PublicSite.Lines(text)) { <p>@para</p> }
                </section>
            }

            @if (Model.Previous is not null && Model.Next is not null)
            {
                <nav class="pager" aria-label="More case studies" data-stagger>
                    <a class="card pager-link" data-enter="card" href="/project/@Model.Previous.Slug" rel="prev">
                        <span class="pager-dir"><span aria-hidden="true">←</span> Previous</span>
                        <span class="pager-title">@Model.Previous.Title</span>
                    </a>
                    <a class="card pager-link next" data-enter="card" href="/project/@Model.Next.Slug" rel="next">
                        <span class="pager-dir">Next <span aria-hidden="true">→</span></span>
                        <span class="pager-title">@Model.Next.Title</span>
                    </a>
                </nav>
            }
        </div>
        <aside data-stagger>
            @if (toc.Count >= 3)
            {
                <nav class="card side-card toc" aria-label="On this page" data-spy data-enter="slide-right">
                    <h2 class="side-title">On this page</h2>
                    <ol>@foreach (var (id, title) in toc) { <li><a href="#@id">@title</a></li> }</ol>
                </nav>
            }
            @if (tech.Length > 0)
            {
                <div class="card side-card" data-enter="slide-right">
                    <h2 class="side-title">Tech</h2>
                    <ul class="chips">@foreach (var t in tech) { <li class="chip" data-enter-item="pop">@t</li> }</ul>
                </div>
            }
            <div class="card side-card" data-enter="slide-right" data-pointer-area>
                <h2 class="side-title">Work with me</h2>
                <p class="muted side-note">Building something similar?</p>
                @if (!string.IsNullOrWhiteSpace(Model.Bio.Email)) { <a class="btn btn-ghost btn-sm" data-pointer="magnet" href="mailto:@Model.Bio.Email">Get in touch</a> }
                else { <a class="btn btn-ghost btn-sm" data-pointer="magnet" href="/#contact">Get in touch</a> }
            </div>
        </aside>
    </div>
</article>

@if (Model.More.Any())
{
    <section class="section" aria-labelledby="more-title">
        <div class="container">
            <div class="section-head" data-enter="heading">
                <div><span class="kicker">More work</span><h2 id="more-title">Other projects</h2></div>
                <a class="text-link" href="/projects">All projects →</a>
            </div>
            <div class="project-grid" data-stagger>
                @foreach (var m in Model.More) { <partial name="_ProjectCard" model="m" /> }
            </div>
        </div>
    </section>
}

@if (images.Any())
{
    <dialog class="lightbox" id="lightbox" aria-label="Image viewer">
        <img src="" alt="" />
        <div class="lightbox-bar">
            <p><span data-counter></span> · <span data-caption></span></p>
            <div class="controls">
                <button type="button" class="icon-btn" data-prev aria-label="Previous image">‹</button>
                <button type="button" class="icon-btn" data-next aria-label="Next image">›</button>
                <button type="button" class="icon-btn" data-close aria-label="Close">✕</button>
            </div>
        </div>
    </dialog>
}
