@model IReadOnlyList<RichText.Block>
@* Renders parsed RichText. Every string goes through Razor's encoder; links were checked by RichText.SafeHref. *@
@functions {
    private void Inlines(IReadOnlyList<RichText.Inline> content)
    {
        foreach (var inline in content)
        {
            switch (inline)
            {
                case RichText.Bold b: <strong>@b.Value</strong> break;
                case RichText.InlineCode c: <code>@c.Value</code> break;
                case RichText.Link l:
                    var external = l.Href.StartsWith("http", StringComparison.OrdinalIgnoreCase);
                    <a href="@l.Href" rel="@(external ? "noopener" : null)" target="@(external ? "_blank" : null)">@l.Label</a>
                    break;
                case RichText.Text t: @t.Value break;
            }
        }
    }
}
@foreach (var block in Model)
{
    switch (block)
    {
        case RichText.Heading h:
            <h2 id="@RichText.HeadingId(h.Text)">@h.Text</h2>
            break;
        case RichText.SubHeading sh:
            <h3>@sh.Text</h3>
            break;
        case RichText.CodeBlock cb:
            <div class="code-block" data-lang="@cb.Language">
                <pre><code class="language-@cb.Language">@cb.Code</code></pre>
            </div>
            break;
        case RichText.Blockquote bq:
            <blockquote><p>@{ Inlines(bq.Content); }</p></blockquote>
            break;
        case RichText.BulletList list:
            <ul>@foreach (var item in list.Items) { <li>@{ Inlines(item); }</li> }</ul>
            break;
        case RichText.Paragraph p:
            <p>@{ Inlines(p.Content); }</p>
            break;
    }
}
