@model ChangePasswordViewModel
@{
    ViewData["Title"] = "Password";
    var dashboardUrl = Url.Action("Index")!;
}
<partial name="_EditHeader" model="@(new EditPageHeader("Dashboard", dashboardUrl, "Change password", "Changing it signs out every other session, including any other browser or device."))" />

<form asp-action="ChangePassword" method="post" class="admin-form form-narrow" data-dirty-guard>
    <div asp-validation-summary="ModelOnly" class="form-alert" role="alert"></div>
    <section class="form-section">
        <div class="form-section-head">
            <h2>New password</h2>
            <p>At least 8 characters. A passphrase of a few random words works well.</p>
        </div>
        <div class="form-grid">
            <div class="field span-2">
                <label asp-for="CurrentPassword" class="form-label"></label>
                <input asp-for="CurrentPassword" class="form-control" autocomplete="current-password" />
                <span asp-validation-for="CurrentPassword" class="field-error"></span>
            </div>
            <div class="field">
                <label asp-for="NewPassword" class="form-label"></label>
                <input asp-for="NewPassword" class="form-control" autocomplete="new-password" />
                <span asp-validation-for="NewPassword" class="field-error"></span>
            </div>
            <div class="field">
                <label asp-for="ConfirmPassword" class="form-label"></label>
                <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" />
                <span asp-validation-for="ConfirmPassword" class="field-error"></span>
            </div>
        </div>
    </section>
    <partial name="_SaveBar" model="@(new SaveBarModel(dashboardUrl, "Update password"))" />
</form>
